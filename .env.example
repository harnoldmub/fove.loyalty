# --- Base de données -------------------------------------------------------
DATABASE_URL=postgresql://amy@localhost:5432/fove_dev
# URL directe (sans pooler) pour les migrations
DIRECT_DATABASE_URL=postgresql://amy@localhost:5432/fove_dev
TEST_DATABASE_URL=postgresql://amy@localhost:5432/fove_test

# --- URLs ------------------------------------------------------------------
APP_URL=http://localhost:5290
API_URL=http://localhost:5291
API_PORT=5291
# Origines autorisées à appeler l'API avec un cookie de session (séparées par des virgules)
CORS_ORIGINS=http://localhost:5290

# --- Secrets ---------------------------------------------------------------
# 32 octets en base64 : openssl rand -base64 32
APP_ENCRYPTION_KEY=
# Secret des tâches planifiées (cron Railway)
CRON_SECRET=

# --- Email -----------------------------------------------------------------
# console (dev : écrit dans EmailOutbox + logs) | resend
EMAIL_PROVIDER=console
EMAIL_FROM="FOVE <no-reply@fove.digital>"
# Destinataire des notifications internes (candidatures, contact, récapitulatif quotidien)
TEAM_ALERT_EMAIL="contact@fove.digital"
RESEND_API_KEY=

# --- Connexion Google du compte client (lot A4) ----------------------------
# Identifiants OAuth 2.0 « Application Web » — sans lien avec Google Wallet.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Doit correspondre exactement à l'URI déclarée dans Google Cloud.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5290/api/auth/google/callback
# Connexion Google des clients FOVE (même identifiant OAuth, deuxième URI à déclarer dans Google Cloud).
GOOGLE_OAUTH_CLIENT_REDIRECT_URI=http://localhost:5290/api/client/auth/google/callback
# Compte client FOVE supprimé après N mois sans activité, avec un email 30 jours avant (0 = jamais).
CLIENT_ACCOUNT_INACTIVE_MONTHS=36
# Parrainage : coupon Stripe « 20, une fois » en USD avec une option EUR (currency_options), remise du filleul.
# Sans lui, pas de remise en mode Stripe.
REFERRAL_STRIPE_COUPON_ID=

# --- Stripe ----------------------------------------------------------------
# Sans clé : mode facturation simulé (aucun paiement réel).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Les tarifs Stripe (USD et EUR) de chaque offre se saisissent dans l'admin > Offres.
# Mode test (TEST_MODE=true) : tarifs sandbox par offre, en dollars puis en euros.
# STRIPE_TEST_PRICE_STARTER_YEARLY_ID= / STRIPE_TEST_PRICE_STARTER_YEARLY_EUR_ID=
# STRIPE_TEST_PRICE_BUSINESS_YEARLY_ID= / STRIPE_TEST_PRICE_BUSINESS_YEARLY_EUR_ID=
# STRIPE_TEST_PRICE_PREMIUM_YEARLY_ID= / STRIPE_TEST_PRICE_PREMIUM_YEARLY_EUR_ID=

# --- Google Wallet (facultatif) ---------------------------------------------
# Sans ces deux variables, le bouton « Ajouter à Google Wallet » est masqué.
GOOGLE_WALLET_ISSUER_ID=
# JSON du compte de service (client_email, private_key), sur une seule ligne
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=

# --- Apple Wallet (facultatif, .pkpass signé) -------------------------------
# Les fichiers PEM sont encodés en base64 : base64 -i pass.pem | tr -d '\n'
APPLE_WALLET_PASS_TYPE_ID=pass.digital.fove.loyalty
APPLE_WALLET_TEAM_ID=
APPLE_WALLET_SIGNER_CERT_PEM_BASE64=
APPLE_WALLET_SIGNER_KEY_PEM_BASE64=
APPLE_WALLET_SIGNER_KEY_PASSPHRASE=
APPLE_WALLET_WWDR_PEM_BASE64=

# --- WhatsApp Business Cloud API (application Meta « DIZAYNA ») --------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=1383855618141061
WHATSAPP_WABA_ID=1048707144878202
WHATSAPP_BUSINESS_ID=796479569088744

# --- Super admin initial (seed) --------------------------------------------
SEED_SUPERADMIN_EMAIL=admin@fove.digital
