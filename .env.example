# --- Base de données -------------------------------------------------------
DATABASE_URL=postgresql://amy@localhost:5432/fove_dev
# URL directe (sans pooler) pour les migrations
DIRECT_DATABASE_URL=postgresql://amy@localhost:5432/fove_dev
TEST_DATABASE_URL=postgresql://amy@localhost:5432/fove_test

# --- URLs ------------------------------------------------------------------
APP_URL=http://localhost:5290
API_URL=http://localhost:5291
API_PORT=5291
# Origines autorisées à appeler l'API avec un cookie de session (séparées par des virgules)
CORS_ORIGINS=http://localhost:5290

# --- Secrets ---------------------------------------------------------------
# 32 octets en base64 : openssl rand -base64 32
APP_ENCRYPTION_KEY=
# Secret des tâches planifiées (cron Railway)
CRON_SECRET=

# --- Email -----------------------------------------------------------------
# console (dev : écrit dans EmailOutbox + logs) | resend
EMAIL_PROVIDER=console
EMAIL_FROM="FOVE <no-reply@fove.digital>"
RESEND_API_KEY=

# --- Stripe ----------------------------------------------------------------
# Sans clé : mode facturation simulé (aucun paiement réel).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Google Wallet (facultatif) ---------------------------------------------
# Sans ces deux variables, le bouton « Ajouter à Google Wallet » est masqué.
GOOGLE_WALLET_ISSUER_ID=
# JSON du compte de service (client_email, private_key), sur une seule ligne
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=

# --- Super admin initial (seed) --------------------------------------------
SEED_SUPERADMIN_EMAIL=admin@fove.digital
SEED_SUPERADMIN_PASSWORD=
