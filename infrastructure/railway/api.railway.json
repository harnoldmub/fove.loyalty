{
  "$schema": "https://railway.com/railway.schema.json",
  "build": { "builder": "DOCKERFILE", "dockerfilePath": "infrastructure/docker/api.Dockerfile", "watchPatterns": ["apps/api/**", "packages/**", "pnpm-lock.yaml"] },
  "deploy": {
    "preDeployCommand": ["pnpm --filter @fove/database migrate:deploy"],
    "startCommand": "node apps/api/dist/main.js",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "numReplicas": 1
  }
}
