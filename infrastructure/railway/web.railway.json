{
  "$schema": "https://railway.com/railway.schema.json",
  "build": { "builder": "DOCKERFILE", "dockerfilePath": "infrastructure/docker/web.Dockerfile", "watchPatterns": ["apps/web/**", "packages/shared/**", "packages/widget/**", "pnpm-lock.yaml"] },
  "deploy": {
    "startCommand": "node apps/web/server.js",
    "healthcheckPath": "/",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "numReplicas": 1
  }
}
