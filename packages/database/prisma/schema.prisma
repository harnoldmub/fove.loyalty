// FOVE — schéma multi-tenant.
//
// Isolation : toute table métier porte `tenantId`. Les relations entre tables
// métier passent par des clés étrangères composites (tenantId, id) : la base
// refuse physiquement qu'un compte de fidélité d'une entreprise pointe vers le
// client ou le programme d'une autre.

generator client {
  provider     = "prisma-client"
  output       = "../generated/client"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Comptes, sessions, rôles
// ---------------------------------------------------------------------------

model User {
  id               String    @id @default(uuid()) @db.Uuid
  email            String    @unique
  name             String
  passwordHash     String
  emailVerifiedAt  DateTime?
  isSuperAdmin     Boolean   @default(false)
  isPartner        Boolean   @default(false)
  adminRole        AdminRole?
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sessions     Session[]
  memberships  TenantMembership[]
  authTokens   AuthToken[]
  supportGrants SupportAccessGrant[]
  partner      Partner?
}

/// Le cookie porte un jeton opaque ; seule son empreinte SHA-256 est stockée.
model Session {
  id             String    @id @default(uuid()) @db.Uuid
  tokenHash      String    @unique
  userId         String    @db.Uuid
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Entreprise choisie. Revérifiée à chaque requête contre les adhésions.
  activeTenantId String?   @db.Uuid
  /// Accès support (super admin) : lecture seule, limité dans le temps.
  supportGrantId String?   @db.Uuid
  userAgent      String?
  ip             String?
  expiresAt      DateTime
  lastSeenAt     DateTime  @default(now())
  createdAt      DateTime  @default(now())

  @@index([userId])
}

enum AuthTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model AuthToken {
  id        String        @id @default(uuid()) @db.Uuid
  type      AuthTokenType
  tokenHash String        @unique
  userId    String        @db.Uuid
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, type])
}

model Permission {
  key         String @id
  description String
}

/// Rôles système (tenantId nul) ou propres à une entreprise (évolution future).
model Role {
  id          String             @id @default(uuid()) @db.Uuid
  key         String
  tenantId    String?            @db.Uuid
  name        String
  permissions String[]
  isSystem    Boolean            @default(false)
  memberships TenantMembership[]
  invitations Invitation[]

  @@unique([tenantId, key])
}

// ---------------------------------------------------------------------------
// Entreprises
// ---------------------------------------------------------------------------

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

model Tenant {
  id          String       @id @default(uuid()) @db.Uuid
  slug        String       @unique
  name        String
  status      TenantStatus @default(ACTIVE)
  suspendedAt DateTime?
  suspendedReason String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  settings       TenantSettings?
  establishments Establishment[]
  memberships    TenantMembership[]
  invitations    Invitation[]
  customers      Customer[]
  identities     CustomerIdentity[]
  programs       LoyaltyProgram[]
  accounts       LoyaltyAccount[]
  transactions   LoyaltyTransaction[]
  rewards        Reward[]
  redemptions    RewardRedemption[]
  enrollmentLinks EnrollmentLink[]
  otps           OtpChallenge[]
  subscription   Subscription?
  apiCredentials ApiCredential[]
  integrations   IntegrationConnection[]
  syncLogs       IntegrationSyncLog[]
  webhooks       WebhookEndpoint[]
  deliveries     WebhookDelivery[]
  idempotency    IdempotencyRecord[]
  auditLogs      AuditLog[]
  supportGrants  SupportAccessGrant[]
  media          MediaAsset[]
  customerNotes  CustomerNote[]
  appleWalletRegistrations AppleWalletRegistration[]
  invoices       Invoice[]
  payments       Payment[]
  partnerCommissions PartnerCommission[]
  attribution    AcquisitionAttribution?
  partnerLeads   PartnerLead[]
  referralRewardsGiven ReferralReward[] @relation("ReferrerTenant")
  referralRewardsReceived ReferralReward[] @relation("ReferredTenant")
}

model TenantSettings {
  tenantId              String    @id @db.Uuid
  tenant                Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  primaryColor          String    @default("#1F4FFF")
  logoUrl               String?
  walletBannerUrl       String?
  walletBannerVersion   String?
  instagramHandle       String?
  country               String    @default("CD")
  currency              String    @default("CDF")
  timezone              String    @default("Africa/Kinshasa")
  legalName             String?
  contactEmail          String?
  privacyPolicyUrl      String?
  /// Durée de conservation des clients inactifs avant anonymisation (mois).
  dataRetentionMonths   Int       @default(36)
  onboardingCompletedAt DateTime?
  updatedAt             DateTime  @updatedAt
}

model Establishment {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  city      String?
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  memberships     MembershipEstablishment[]
  enrollmentLinks EnrollmentLink[]

  @@unique([tenantId, id])
  @@index([tenantId])
}

enum MembershipStatus {
  ACTIVE
  DISABLED
}

model TenantMembership {
  id                String           @id @default(uuid()) @db.Uuid
  tenantId          String           @db.Uuid
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId            String           @db.Uuid
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId            String           @db.Uuid
  role              Role             @relation(fields: [roleId], references: [id])
  status            MembershipStatus @default(ACTIVE)
  /// Vrai : accès à tous les établissements. Faux : seulement ceux listés.
  allEstablishments Boolean          @default(true)
  createdAt         DateTime         @default(now())

  establishments MembershipEstablishment[]

  @@unique([tenantId, userId])
  @@unique([tenantId, id])
  @@index([userId])
}

model MembershipEstablishment {
  tenantId        String           @db.Uuid
  membershipId    String           @db.Uuid
  membership      TenantMembership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Cascade)
  establishmentId String           @db.Uuid
  establishment   Establishment    @relation(fields: [tenantId, establishmentId], references: [tenantId, id], onDelete: Cascade)

  @@id([membershipId, establishmentId])
}

model Invitation {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @db.Uuid
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email            String
  roleId           String    @db.Uuid
  role             Role      @relation(fields: [roleId], references: [id])
  establishmentIds String[]
  tokenHash        String    @unique
  invitedById      String    @db.Uuid
  expiresAt        DateTime
  acceptedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([tenantId, email])
}

// ---------------------------------------------------------------------------
// Clients
// ---------------------------------------------------------------------------

enum CustomerSource {
  DASHBOARD
  QR_ENROLLMENT
  IMPORT
  API
  INTEGRATION
}

model Customer {
  id                    String         @id @default(uuid()) @db.Uuid
  tenantId              String         @db.Uuid
  tenant                Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  firstName             String
  lastName              String         @default("")
  email                 String?
  phone                 String?
  externalRef           String?
  source                CustomerSource @default(DASHBOARD)
  termsAcceptedAt       DateTime?
  /// Consentements marketing distincts du consentement au programme.
  marketingEmailConsent Boolean        @default(false)
  marketingSmsConsent   Boolean        @default(false)
  consentUpdatedAt      DateTime?
  anonymizedAt          DateTime?
  tags                  String[]       @default([])
  notes                 String?
  lastVisitAt           DateTime?
  totalVisits           Int            @default(0)
  totalSpend            Decimal        @default(0) @db.Decimal(14, 2)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  identities    CustomerIdentity[]
  accounts      LoyaltyAccount[]
  customerNotes CustomerNote[]

  @@unique([tenantId, id])
  @@index([tenantId, createdAt])
  @@index([tenantId, lastName, firstName])
  @@index([tenantId, lastVisitAt])
}

model CustomerNote {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId String   @db.Uuid
  customer   Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)
  authorName String
  authorId   String?  @db.Uuid
  content    String
  createdAt  DateTime @default(now())

  @@unique([tenantId, id])
  @@index([tenantId, customerId, createdAt])
}

enum IdentityKind {
  PHONE
  EMAIL
  EXTERNAL
}

/// Identifiants uniques d'un client dans une entreprise : empêchent les
/// doublons sans fusionner deux personnes sur la base d'un simple nom.
model CustomerIdentity {
  id         String       @id @default(uuid()) @db.Uuid
  tenantId   String       @db.Uuid
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId String       @db.Uuid
  customer   Customer     @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)
  kind       IdentityKind
  value      String
  verifiedAt DateTime?
  createdAt  DateTime     @default(now())

  @@unique([tenantId, kind, value])
  @@index([customerId])
}

// ---------------------------------------------------------------------------
// Fidélité
// ---------------------------------------------------------------------------

enum ProgramMode {
  POINTS
  STAMPS
}

enum EnrollmentVerification {
  NONE
  EMAIL_OTP
  IN_STORE
}

model LoyaltyProgram {
  id                     String                 @id @default(uuid()) @db.Uuid
  tenantId               String                 @db.Uuid
  tenant                 Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                   String
  mode                   ProgramMode
  currency               String
  spendStep              Decimal                @default(1000) @db.Decimal(14, 2)
  pointsPerStep          Int                    @default(1)
  stampsPerPurchase      Int                    @default(1)
  stampsTarget           Int                    @default(10)
  minPurchaseAmount      Decimal?               @db.Decimal(14, 2)
  maxPerTransaction      Int?
  inactivityExpiryDays   Int?
  /// Un seul passage compté par client et par jour (fuseau de l'entreprise), hors commandes en ligne.
  oneVisitPerDay         Boolean                @default(false)
  enrollmentVerification EnrollmentVerification @default(NONE)
  terms                  String                 @default("")
  active                 Boolean                @default(true)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  accounts        LoyaltyAccount[]
  rewards         Reward[]
  enrollmentLinks EnrollmentLink[]

  @@unique([tenantId, id])
  @@index([tenantId])
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  BLOCKED
  CLOSED
}

model LoyaltyAccount {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @db.Uuid
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  programId       String         @db.Uuid
  program         LoyaltyProgram @relation(fields: [tenantId, programId], references: [tenantId, id], onDelete: Restrict)
  customerId      String         @db.Uuid
  customer        Customer       @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  /// Numéro lisible imprimé sur la carte (FV-XXXX-XXXX).
  cardNumber      String
  /// Contenu du QR personnel : identifie la carte, ne donne aucun droit.
  qrToken         String         @unique
  /// Empreinte du jeton secret du lien de la carte numérique (recherche).
  accessTokenHash String         @unique
  /// Même jeton chiffré (AES-256-GCM) : le lien peut être renvoyé au client
  /// (WhatsApp, « Retrouver ma carte ») sans être renouvelé.
  accessTokenEncrypted String?
  status          AccountStatus  @default(ACTIVE)
  /// Solde mis en cache, toujours égal au `balanceAfter` de la dernière opération.
  balance         Int            @default(0)
  lifetimeEarned  Int            @default(0)
  lifetimeSpent   Int            @default(0)
  lastActivityAt       DateTime       @default(now())
  lastWalletMessageTitle String?
  lastWalletMessageBody  String?
  lastWalletMessageAt    DateTime?
  createdAt            DateTime       @default(now())

  transactions LoyaltyTransaction[]
  redemptions  RewardRedemption[]
  otps         OtpChallenge[]

  @@unique([tenantId, id])
  @@unique([tenantId, programId, customerId])
  @@unique([tenantId, cardNumber])
  @@index([tenantId, programId, createdAt])
}

enum TransactionKind {
  EARN
  ADJUSTMENT
  REDEMPTION
  REDEMPTION_REVERSAL
  REVERSAL
  REFUND
  EXPIRATION
}

enum OperationSource {
  DASHBOARD
  SCANNER
  API
  INTEGRATION
  SYSTEM
}

/// Historique immuable. Une correction = une nouvelle ligne compensatoire.
model LoyaltyTransaction {
  id             String          @id @default(uuid()) @db.Uuid
  tenantId       String          @db.Uuid
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accountId      String          @db.Uuid
  account        LoyaltyAccount  @relation(fields: [tenantId, accountId], references: [tenantId, id], onDelete: Restrict)
  kind           TransactionKind
  delta          Int
  balanceAfter   Int
  amount         Decimal?        @db.Decimal(14, 2)
  currency       String?
  saleReference  String?
  externalOrderId String?
  reason         String?
  idempotencyKey String
  /// Annulation totale : une opération ne peut être annulée qu'une fois.
  reversesId     String?         @unique @db.Uuid
  reverses       LoyaltyTransaction?  @relation("Reversal", fields: [reversesId], references: [id], onDelete: Restrict)
  reversedBy     LoyaltyTransaction?  @relation("Reversal")
  /// Remboursement partiel : plusieurs lignes possibles, plafonnées au gain initial.
  refundOfId     String?         @db.Uuid
  establishmentId String?        @db.Uuid
  actorUserId    String?         @db.Uuid
  actorApiKeyId  String?         @db.Uuid
  source         OperationSource
  createdAt      DateTime        @default(now())

  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, id])
  @@index([tenantId, createdAt])
  @@index([accountId, createdAt])
  @@index([tenantId, externalOrderId])
  @@index([refundOfId])
}

enum RewardKind {
  GIFT
  PERCENTAGE
  FIXED
}

model Reward {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @db.Uuid
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  programId      String         @db.Uuid
  program        LoyaltyProgram @relation(fields: [tenantId, programId], references: [tenantId, id], onDelete: Restrict)
  name           String
  description    String         @default("")
  conditions     String         @default("")
  kind           RewardKind     @default(GIFT)
  value          Decimal?       @db.Decimal(14, 2)
  cost           Int
  stock          Int?
  availableFrom  DateTime?
  availableUntil DateTime?
  active         Boolean        @default(true)
  archivedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  redemptions RewardRedemption[]

  @@unique([tenantId, id])
  @@index([tenantId, programId, active])
}

enum RedemptionStatus {
  COMPLETED
  CANCELLED
}

model RewardRedemption {
  id                    String           @id @default(uuid()) @db.Uuid
  tenantId              String           @db.Uuid
  tenant                Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accountId             String           @db.Uuid
  account               LoyaltyAccount   @relation(fields: [tenantId, accountId], references: [tenantId, id], onDelete: Restrict)
  rewardId              String           @db.Uuid
  reward                Reward           @relation(fields: [tenantId, rewardId], references: [tenantId, id], onDelete: Restrict)
  rewardKind            RewardKind       @default(GIFT)
  rewardValue           Decimal?         @db.Decimal(14, 2)
  purchaseAmount        Decimal?         @db.Decimal(14, 2)
  discountAmount        Decimal?         @db.Decimal(14, 2)
  currency              String?
  rewardName            String
  cost                  Int
  status                RedemptionStatus @default(COMPLETED)
  transactionId         String           @unique @db.Uuid
  reversalTransactionId String?          @unique @db.Uuid
  idempotencyKey        String
  establishmentId       String?          @db.Uuid
  actorUserId           String?          @db.Uuid
  cancelledById         String?          @db.Uuid
  cancelReason          String?
  cancelledAt           DateTime?
  createdAt             DateTime         @default(now())

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, createdAt])
  @@index([accountId])
}

/// QR d'inscription public (différent du QR personnel de la carte).
model EnrollmentLink {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @db.Uuid
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  programId       String         @db.Uuid
  program         LoyaltyProgram @relation(fields: [tenantId, programId], references: [tenantId, id], onDelete: Cascade)
  establishmentId String?        @db.Uuid
  establishment   Establishment? @relation(fields: [tenantId, establishmentId], references: [tenantId, id], onDelete: Cascade)
  token           String         @unique
  active          Boolean        @default(true)
  enrollCount     Int            @default(0)
  createdAt       DateTime       @default(now())

  @@index([tenantId])
}

model OtpChallenge {
  id         String         @id @default(uuid()) @db.Uuid
  tenantId   String         @db.Uuid
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accountId  String         @db.Uuid
  account    LoyaltyAccount @relation(fields: [tenantId, accountId], references: [tenantId, id], onDelete: Cascade)
  channel    String
  target     String
  codeHash   String
  attempts   Int            @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime       @default(now())

  @@index([accountId])
}

// ---------------------------------------------------------------------------
// Abonnements
// ---------------------------------------------------------------------------

/// FREE : offre par défaut (une seule) ; PAID : achetable en ligne ; CUSTOM : sur devis, attribuée par l'admin.
enum PlanKind {
  FREE
  PAID
  CUSTOM
}

model SubscriptionPlan {
  id                  String         @id @default(uuid()) @db.Uuid
  code                String         @unique
  kind                PlanKind       @default(PAID)
  name                String
  description         String         @default("")
  currency            String         @default("EUR")
  priceMonthlyCents   Int
  priceYearlyCents    Int
  stripePriceMonthlyId String?
  stripePriceYearlyId  String?
  trialDays           Int            @default(14)
  /// Fonctions incluses : { api, widget, integrations, exports, walletCampaigns, whatsappAuto, removeBranding } (booléens).
  features            Json
  /// Quotas : { customers, establishments, staff, programs } (null = illimité).
  limits              Json
  active              Boolean        @default(true)
  sortOrder           Int            @default(0)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  subscriptions Subscription[] @relation("CurrentPlan")
  scheduledSubscriptions Subscription[] @relation("ScheduledPlan")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum BillingInterval {
  MONTH
  YEAR
}

enum BillingProvider {
  STRIPE
  MOCK
  MANUAL
}

model Subscription {
  id                   String             @id @default(uuid()) @db.Uuid
  tenantId             String             @unique @db.Uuid
  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId               String             @db.Uuid
  plan                 SubscriptionPlan   @relation("CurrentPlan", fields: [planId], references: [id])
  /// Offre inférieure choisie par le commerçant : appliquée au renouvellement, l'offre payée reste jusque-là.
  scheduledPlanId      String?            @db.Uuid
  scheduledPlan        SubscriptionPlan?  @relation("ScheduledPlan", fields: [scheduledPlanId], references: [id])

  status               SubscriptionStatus
  interval             BillingInterval    @default(MONTH)
  provider             BillingProvider    @default(MOCK)
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  /// Début de l'impayé en cours : les droits sont gardés pendant le délai de grâce, puis le Gratuit s'applique.
  pastDueSince         DateTime?
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  /// Contrat sur-mesure : quotas et fonctions négociés, prioritaires sur ceux de l'offre.
  limitsOverride       Json?
  featuresOverride     Json?
  /// Prix annuel du contrat sur-mesure, facturé hors Stripe (statistiques admin).
  contractPriceYearlyCents Int?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  invoices             Invoice[]
}

/// Événements de facturation déjà traités : un webhook rejoué n'a aucun effet.
model BillingEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Intégrations, API, webhooks
// ---------------------------------------------------------------------------

enum ApiKeyKind {
  SECRET
  PUBLISHABLE
}

enum ApiEnvironment {
  TEST
  LIVE
}

model ApiCredential {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @db.Uuid
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  kind           ApiKeyKind
  environment    ApiEnvironment @default(TEST)
  /// Début lisible de la clé (affichage seulement).
  prefix         String
  keyHash        String         @unique
  scopes         String[]
  allowedOrigins String[]
  createdById    String?        @db.Uuid
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime       @default(now())

  @@index([tenantId])
}

enum IntegrationProvider {
  MATCH_KWATA
  CUSTOM
}

enum IntegrationStatus {
  ACTIVE
  PAUSED
  ERROR
}

model IntegrationConnection {
  id              String              @id @default(uuid()) @db.Uuid
  tenantId        String              @db.Uuid
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider        IntegrationProvider
  name            String
  status          IntegrationStatus   @default(ACTIVE)
  programId       String?             @db.Uuid
  apiCredentialId String?             @db.Uuid
  config          Json                @default("{}")
  lastSyncAt      DateTime?
  lastError       String?
  createdAt       DateTime            @default(now())

  syncLogs IntegrationSyncLog[]

  @@unique([tenantId, provider, name])
  @@unique([tenantId, id])
}

model IntegrationSyncLog {
  id           String                 @id @default(uuid()) @db.Uuid
  tenantId     String                 @db.Uuid
  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connectionId String?                @db.Uuid
  connection   IntegrationConnection? @relation(fields: [tenantId, connectionId], references: [tenantId, id], onDelete: Cascade)
  kind         String
  externalId   String
  status       String
  error        String?
  createdAt    DateTime               @default(now())

  @@index([tenantId, createdAt])
}

model WebhookEndpoint {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  url             String
  /// Secret de signature chiffré (AES-256-GCM, clé APP_ENCRYPTION_KEY).
  secretEncrypted String
  events          String[]
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  deliveries WebhookDelivery[]

  @@unique([tenantId, id])
}

enum DeliveryStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model WebhookDelivery {
  id             String          @id @default(uuid()) @db.Uuid
  tenantId       String          @db.Uuid
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  endpointId     String          @db.Uuid
  endpoint       WebhookEndpoint @relation(fields: [tenantId, endpointId], references: [tenantId, id], onDelete: Cascade)
  event          String
  payload        Json
  status         DeliveryStatus  @default(PENDING)
  attempts       Int             @default(0)
  nextAttemptAt  DateTime        @default(now())
  lastStatusCode Int?
  lastError      String?
  deliveredAt    DateTime?
  createdAt      DateTime        @default(now())

  @@index([status, nextAttemptAt])
  @@index([tenantId, createdAt])
}

/// Réponses mémorisées pour l'en-tête `Idempotency-Key` de l'API publique.
model IdempotencyRecord {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key          String
  requestHash  String
  statusCode   Int
  responseBody Json
  createdAt    DateTime @default(now())

  @@unique([tenantId, key])
}

// ---------------------------------------------------------------------------
// Plateforme
// ---------------------------------------------------------------------------

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String?  @db.Uuid
  tenant        Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorUserId   String?  @db.Uuid
  actorApiKeyId String?  @db.Uuid
  action        String
  targetType    String?
  targetId      String?
  metadata      Json?
  ip            String?
  createdAt     DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([action, createdAt])
}

model SupportAccessGrant {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  superAdminId String    @db.Uuid
  superAdmin   User      @relation(fields: [superAdminId], references: [id], onDelete: Cascade)
  reason       String
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([tenantId])
}

model EmailOutbox {
  id        String    @id @default(uuid()) @db.Uuid
  to        String
  subject   String
  text      String
  html      String?
  provider  String
  status    String    @default("PENDING")
  error     String?
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([to, createdAt])
}

model ErrorLog {
  id        String   @id @default(uuid()) @db.Uuid
  requestId String?
  method    String?
  path      String?
  status    Int
  message   String
  stack     String?
  tenantId  String?  @db.Uuid
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Médias (logos). Stockés en base en V1 ; le pilote `MediaStorage` de l'API
/// permet de basculer vers un stockage objet (S3, R2) sans changer les URLs.
model MediaAsset {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contentType String
  size        Int
  data        Bytes?
  storageKey  String?
  createdAt   DateTime @default(now())

  @@index([tenantId])
}

enum ContactStatus {
  NEW
  IN_PROGRESS
  CONTACTED
  ARCHIVED
}

model ContactMessage {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  email       String
  phone       String?
  companyName String?
  subject     String?
  message     String
  source      String        @default("WEBSITE")
  status      ContactStatus @default(NEW)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, createdAt])
}

model AppleWalletRegistration {
  id                      String   @id @default(uuid()) @db.Uuid
  tenantId                String   @db.Uuid
  tenant                  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deviceLibraryIdentifier String
  passTypeIdentifier      String
  serialNumber            String   /// LoyaltyAccount id
  pushToken               String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([deviceLibraryIdentifier, serialNumber])
  @@index([serialNumber])
  @@index([passTypeIdentifier])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Centre financier, facturation, commissions et trésorerie
// ---------------------------------------------------------------------------

enum AdminRole {
  SUPER_ADMIN
  ASSOCIATE
  FINANCE_MANAGER
  SUPPORT
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

model Invoice {
  id                  String        @id @default(uuid()) @db.Uuid
  number              String        @unique /// Numéro séquentiel lisible (ex: INV-2026-0001)
  tenantId            String        @db.Uuid
  tenant              Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriptionId      String?       @db.Uuid
  subscription        Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  status              InvoiceStatus @default(OPEN)
  currency            String        @default("USD")
  amountSubtotalCents Int           /// Montant HT en centimes
  amountTaxCents      Int           @default(0) /// Taxes collectées
  amountDiscountCents Int           @default(0) /// Remises / crédits appliqués
  amountTotalCents    Int           /// Montant total TTC facturé
  amountPaidCents     Int           @default(0) /// Montant réellement encaissé
  amountDueCents      Int           @default(0) /// Reste à payer

  periodStart         DateTime?
  periodEnd           DateTime?
  dueDate             DateTime?
  paidAt              DateTime?
  voidedAt            DateTime?

  stripeInvoiceId     String?       @unique
  pdfUrl              String?
  hostedInvoiceUrl    String?
  billingReason       String?       /// subscription_create, subscription_cycle, manual, custom_contract
  metadata            Json?

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  lines               InvoiceLine[]
  payments            Payment[]
  partnerCommissions  PartnerCommission[]

  @@index([tenantId, createdAt])
  @@index([status])
}

model InvoiceLine {
  id                  String   @id @default(uuid()) @db.Uuid
  invoiceId           String   @db.Uuid
  invoice             Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description         String
  quantity            Int      @default(1)
  unitAmountCents     Int
  amountSubtotalCents Int
  amountTaxCents      Int      @default(0)
  amountTotalCents    Int
  currency            String   @default("USD")
  planId              String?  @db.Uuid

  @@index([invoiceId])
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
  DISPUTED
}

enum PaymentProvider {
  STRIPE
  MANUAL
  MOCK
  BANK_TRANSFER
  MOBILE_MONEY
}

model Payment {
  id                   String          @id @default(uuid()) @db.Uuid
  reference            String          @unique /// Référence unique (ex: PAY-2026-0001)
  tenantId             String          @db.Uuid
  tenant               Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId            String?         @db.Uuid
  invoice              Invoice?        @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  provider             PaymentProvider @default(STRIPE)
  providerPaymentId    String?         /// ID Stripe PaymentIntent / Charge
  amountCents          Int             /// Montant brut payé
  amountRefundedCents  Int             @default(0)
  feeCents             Int             @default(0) /// Frais du prestataire (ex: Stripe)
  netCents             Int             /// Montant net reçu (amountCents - feeCents)
  currency             String          @default("USD")
  status               PaymentStatus   @default(PENDING)
  method               String?         /// card, bank_transfer, airtel_money, orange_money, mpesa, cash
  failureCode          String?
  failureMessage       String?

  partnerId            String?         @db.Uuid
  partner              Partner?        @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  confirmedAt          DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  refunds              Refund[]
  partnerCommissions   PartnerCommission[]

  @@index([tenantId, createdAt])
  @@index([status])
  @@index([providerPaymentId])
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model Refund {
  id                  String       @id @default(uuid()) @db.Uuid
  paymentId           String       @db.Uuid
  payment             Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amountCents         Int
  currency            String       @default("USD")
  reason              String
  status              RefundStatus @default(SUCCEEDED)
  providerRefundId    String?
  initiatedByUserId   String?      @db.Uuid
  createdAt           DateTime     @default(now())

  @@index([paymentId])
}

enum PartnerStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  ACTIVE
  PAUSED
  SUSPENDED
  REJECTED
  INACTIVE
}

model Partner {
  id                          String              @id @default(uuid()) @db.Uuid
  userId                      String?             @unique @db.Uuid
  user                        User?               @relation(fields: [userId], references: [id], onDelete: SetNull)

  name                        String
  email                       String              @unique
  code                        String              @unique /// Code d'apporteur d'affaires (ex: AGENCE243)
  phone                       String?
  company                     String?
  partnerType                 String?             /// AGENCY, FREELANCE, CONSULTANT, DEVELOPER, ENTREPRENEUR, MERCHANT_NETWORK, OTHER
  websiteUrl                  String?
  country                     String?
  city                        String?
  promotionStrategy           String?             /// Stratégie de promotion renseignée
  networkSizeEstimate         String?             /// Nombre estimé de commerçants
  commissionRatePercent       Decimal             @default(20.00) @db.Decimal(5, 2)
  status                      PartnerStatus       @default(PENDING)
  rejectionReason             String?
  payoutInfo                  Json?               /// Coordonnées bancaires ou Mobile Money
  minimumPayoutThresholdCents Int                 @default(5000) /// 50.00 USD / EUR par défaut
  totalClicksCount            Int                 @default(0)
  totalConversionsCount       Int                 @default(0)

  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt

  payments                    Payment[]
  commissions                 PartnerCommission[]
  payouts                     PartnerPayout[]
  clicks                      PartnerClick[]
  leads                       PartnerLead[]
  attributions                AcquisitionAttribution[]
}

model PartnerClick {
  id          String   @id @default(uuid()) @db.Uuid
  partnerId   String   @db.Uuid
  partner     Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  code        String
  ipHash      String?
  userAgent   String?
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  createdAt   DateTime @default(now())

  @@index([partnerId])
  @@index([code])
}

model PartnerLead {
  id                  String   @id @default(uuid()) @db.Uuid
  partnerId           String   @db.Uuid
  partner             Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  businessName        String
  contactName         String?
  email               String?
  phone               String?
  city                String?
  country             String?
  sector              String?
  notes               String?
  status              String   @default("NEW") /// NEW, CONTACTED, INTERESTED, REGISTERED, CONVERTED, LOST
  registeredTenantId  String?  @db.Uuid
  registeredTenant    Tenant?  @relation(fields: [registeredTenantId], references: [id], onDelete: SetNull)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([partnerId])
}

model AcquisitionAttribution {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @unique @db.Uuid
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  partnerId         String   @db.Uuid
  partner           Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  code              String
  utmSource         String?
  utmCampaign       String?
  attributionSource String   @default("COOKIE") /// COOKIE, MANUAL_CODE, ADMIN_OVERRIDE
  firstPaymentAt    DateTime?
  conversionStatus  String   @default("REGISTERED") /// REGISTERED, CONVERTED, CHURNED

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([partnerId])
}

model PartnerSettings {
  id                          String   @id @default("default")
  defaultCommissionRatePercent Decimal  @default(20.00) @db.Decimal(5, 2)
  cookieAttributionDays       Int      @default(30)
  conversionWindowDays        Int      @default(90)
  validationDelayDays         Int      @default(30)
  minimumPayoutThresholdCents Int      @default(5000)
  firstPaymentOnly            Boolean  @default(true)
  autoApproveApplications     Boolean  @default(false)
  updatedAt                   DateTime @updatedAt
}

enum CommissionStatus {
  PENDING
  CONFIRMED
  AVAILABLE
  PAID
  CANCELLED
  REVERSED
}

model PartnerCommission {
  id                    String           @id @default(uuid()) @db.Uuid
  partnerId             String           @db.Uuid
  partner               Partner          @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  tenantId              String           @db.Uuid
  tenant                Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paymentId             String?          @db.Uuid
  payment               Payment?         @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  invoiceId             String?          @db.Uuid
  invoice               Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  amountBaseCents       Int              /// Montant encaissé servant de base
  commissionRatePercent Decimal          @db.Decimal(5, 2)
  commissionAmountCents Int              /// Montant de la commission
  currency              String           @default("USD")
  status                CommissionStatus @default(PENDING)

  availableAt           DateTime?
  paidAt                DateTime?
  payoutId              String?          @db.Uuid
  payout                PartnerPayout?   @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([partnerId])
  @@index([tenantId])
}

model PartnerPayout {
  id                String              @id @default(uuid()) @db.Uuid
  partnerId         String              @db.Uuid
  partner           Partner             @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  amountCents       Int
  currency          String              @default("USD")
  method            String              /// Virement, Mobile Money, Cash
  status            String              @default("PAID") /// PENDING, PAID, FAILED
  reference         String?
  proofFileUrl      String?
  approvedByUserId  String?             @db.Uuid
  paidAt            DateTime?           @default(now())
  createdAt         DateTime            @default(now())

  commissions       PartnerCommission[]

  @@index([partnerId])
}

model ReferralReward {
  id                  String   @id @default(uuid()) @db.Uuid
  referrerTenantId    String   @db.Uuid
  referrerTenant      Tenant   @relation("ReferrerTenant", fields: [referrerTenantId], references: [id], onDelete: Cascade)
  referredTenantId    String   @db.Uuid
  referredTenant      Tenant   @relation("ReferredTenant", fields: [referredTenantId], references: [id], onDelete: Cascade)
  creditAmountCents   Int      /// Montant du crédit accordé
  creditUsedCents     Int      @default(0)
  creditRemainingCents Int
  currency            String   @default("USD")
  status              String   @default("ACTIVE") /// ACTIVE, EXHAUSTED, CANCELLED
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([referrerTenantId, referredTenantId])
}

enum ExpenseCategory {
  HOSTING
  DATABASE
  EMAILS
  DOMAINS
  SAAS
  MARKETING
  ADS
  DEV
  FREELANCE
  BANK_FEES
  LEGAL
  OFFICE
  OTHER
}

enum ExpenseStatus {
  PLANNED
  PAID
  CANCELLED
}

model Expense {
  id                 String          @id @default(uuid()) @db.Uuid
  reference          String          @unique /// Référence (ex: EXP-2026-0001)
  title              String
  supplier           String
  category           ExpenseCategory
  amountCents        Int
  currency           String          @default("USD")
  taxCents           Int             @default(0)
  isRecurring        Boolean         @default(false)
  recurringInterval  String?         /// month, year
  status             ExpenseStatus   @default(PAID)
  paymentMethod      String?
  proofUrl           String?
  expenseDate        DateTime
  createdById        String?         @db.Uuid
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([category])
  @@index([expenseDate])
}

model BankStatementEntry {
  id                 String    @id @default(uuid()) @db.Uuid
  entryDate          DateTime
  label              String
  amountCents        Int       /// Positif = encaissement/crédit, négatif = décaissement/débit
  currency           String    @default("USD")
  reconciled         Boolean   @default(false)
  reconciledType     String?   /// PAYMENT, EXPENSE, PARTNER_PAYOUT
  reconciledId       String?   @db.Uuid
  source             String    @default("MANUAL") /// IMPORT_CSV, MANUAL
  notes              String?
  createdAt          DateTime  @default(now())

  @@index([reconciled])
  @@index([entryDate])
}

model FinancialAuditLog {
  id                 String   @id @default(uuid()) @db.Uuid
  actorUserId        String?  @db.Uuid
  actorEmail         String
  action             String   /// expense.create, payment.refund, partner.commission_paid, etc.
  entityType         String   /// invoice, payment, refund, expense, partner, commission
  entityId           String
  oldValue           Json?
  newValue           Json?
  reason             String?
  ip                 String?
  createdAt          DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

